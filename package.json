{
  "name": "theshare",
  "private": true,
  "version": "0.1.0",
  "description": "Backend'siz, açık kaynaklı P2P dosya paylaşım PWA'sı (WebRTC + QR signaling)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https --host",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "barcode-detector": "^3.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "^0.1.3",
    "workbox-window": "^7.4.1",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
